 "font_size": 14,
 "html": "<div style=\"border:1px solid #000; padding:15px; font-family:Arial;\">\n  <h2 style=\"text-align:center;\">{{ doc.company }}</h2>\n  <h4 style=\"text-align:center;\">Salary Slip between {{ doc.start_date }} & {{ doc.end_date }}</h4>\n  \n  <p><b>Employee:</b> {{ doc.employee_name }}</p>\n  <p><b>Employee ID:</b> {{ doc.employee }}</p>\n  <p><b>Designation:</b> {{ doc.designation }}</p>\n  <p><b>Department:</b> {{ doc.department }}</p>\n\n  <table style=\"width:100%; border-collapse:collapse;\" border=\"1\">\n    <thead>\n      <tr><th>Earnings</th><th>Amount</th></tr>\n    </thead>\n    <tbody>\n      {% for e in doc.earnings %}\n      <tr>\n        <td>{{ e.salary_component }}</td>\n        <td style=\"text-align:right;\">{{ e.amount }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <table style=\"width:100%; border-collapse:collapse; margin-top:10px;\" border=\"1\">\n    <thead>\n      <tr><th>Deductions</th><th>Amount</th></tr>\n    </thead>\n    <tbody>\n      {% for d in doc.deductions %}\n      <tr>\n        <td>{{ d.salary_component }}</td>\n        <td style=\"text-align:right;\">{{ d.amount }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <h3 style=\"text-align:right;\">Net Pay: {{ doc.net_pay }}</h3>\n</div>",
